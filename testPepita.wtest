import pepita.pepita

describe "grupo de pruebas para pepita" {

  test "pepita tiene energia inicial" {
    assert.equals(100, pepita.energia())
  }

  test "pepita puede volar" {
    pepita.volar(5)
    assert.equals(85, pepita.energia())
  }

  test "pepita volar mas" {
    pepita.volar(5)
    assert.equals(85, pepita.energia())
    pepita.volar(5)
    assert.equals(70 , pepita.energia())
  }
}